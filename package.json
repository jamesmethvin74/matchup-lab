{
  "name": "matchup-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test test/*.test.js",
    "check": "node --check src/worker.js && node --check src/ingest.js && node --check src/model.js && node --check src/backtest.js && node --check web/app.js && npm test",
    "dev": "wrangler dev --test-scheduled",
    "deploy:cloudflare": "npm run check && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply matchup-lab --local",
    "db:migrate:remote": "wrangler d1 migrations apply matchup-lab --remote"
  },
  "devDependencies": { "wrangler": "^4.0.0" }
}
